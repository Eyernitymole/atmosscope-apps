<Window x:Class="AtmosScope.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="天衡气象 · AtmosScope" Width="1440" Height="900" MinWidth="960" MinHeight="640" Background="#071018" Icon="Assets/AtmosScope.ico" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0A1C2A" Padding="12,7">
            <StackPanel Orientation="Horizontal">
                <Button Width="120" Margin="0,0,8,0" Click="OrdinaryWeather_Click" Content="普通天气"/>
                <Button Width="120" Click="ProfessionalAtlas_Click" Content="专业图集"/>
                <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Foreground="#8EABB9" Text="普通天气保留现有站点 · 专业图集使用本地前端与真实数据源"/>
            </StackPanel>
        </Border>
        <wv2:WebView2 Grid.Row="1" x:Name="WeatherView"/>
        <Border x:Name="RuntimeError" Grid.RowSpan="2" Background="#071018" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <TextBlock Text="需要安装 Microsoft Edge WebView2 Runtime" Foreground="#F1F7FA" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock Margin="0,16,0,24" Text="AtmosScope 使用微软的安全网页运行环境。安装后重新打开应用即可。" Foreground="#9DB3BE" FontSize="15" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button Padding="20,10" HorizontalAlignment="Center" Click="InstallRuntime_Click" Content="打开微软官方下载页"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
